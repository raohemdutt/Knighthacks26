+static int mindiv_int4(int N, int div1, int div2) {
+  int nPrRnd = div1 * div2;
+  int limit = div2 < 13 ? div2 : 13;
+  int rnds[16];
+  for (int i = 0; i < limit; i++) {
+    rnds[i] = (N + nPrRnd - 1) / nPrRnd;
+    nPrRnd -= div1;
+  }
+  for (int i = limit - 1; i >= 0; i--)
+    if (rnds[0] == rnds[i]) return (div2 - i);
+  return 0;
+}
