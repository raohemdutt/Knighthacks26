vLLM change that lets the ExLlama GPTQ kernel serve 3-bit and 2-bit compressed-tensors checkpoints on ROCm
(git apply ignores this text before the first diff header).
Target: vLLM main 276fbcff2717 (2026-10-10); the file is unchanged at 01abe975b583 (2026-10-10), where it applies too.
It does NOT apply at b1388b1 (the April build lab/pod_a_teacher.sh pins): there exllama.py still has the act-order
g_idx code removed by #54809, and, more to the point, b1388b1's compressed-tensors WNA16 loader accepts only 4 and 8
bits (2 to 7 bits with dense packing came with #46389), so a low-bit checkpoint needs the upgraded vLLM.
What it does: the csrc ExLlama GPTQ kernels already read 2-bit and 3-bit rows (MatrixView_q2_row, MatrixView_q3_row,
shuffle_3bit); the Python kernel only refused the types and packed the synthetic zero points 10 to a word, which is
wrong for the dense 3-bit layout. Every other ROCm kernel (RDNA3, RDNA hybrid, Triton W4A16, Conch) is 4/8-bit only,
so with this patch ExLlama is the one that serves these widths, and it needs float16 activations (--dtype float16).
Apply: cd vllm && git apply <this file>

diff --git a/vllm/model_executor/kernels/linear/mixed_precision/exllama.py b/vllm/model_executor/kernels/linear/mixed_precision/exllama.py
index d50a226..f89ff49 100644
--- a/vllm/model_executor/kernels/linear/mixed_precision/exllama.py
+++ b/vllm/model_executor/kernels/linear/mixed_precision/exllama.py
@@ -15,10 +15,37 @@ from vllm.scalar_type import scalar_types
 from .MPLinearKernel import MPLinearKernel, MPLinearLayerConfig
 
 
+def _zp_pack_columns(weight_type) -> int:
+    # 3-bit zero points are packed densely, 32 values in 3 words, as the
+    # kernel's MatrixView_q3_row reads them; other widths divide 32.
+    bits = weight_type.size_bits
+    return 32 if 32 % bits else 32 // bits
+
+
+def _pack_3bit_rows_dense(values: torch.Tensor) -> torch.Tensor:
+    # Packs [rows, cols] 3-bit values (cols % 32 == 0) along cols into
+    # [rows, cols * 3 // 32] int32: value i of each 32-wide block starts at
+    # bit 3 * i of the block's 96-bit little-endian stream.
+    rows, cols = values.shape
+    v = (values.to(torch.int64) & 0x7).reshape(rows, cols // 32, 32)
+    words = torch.zeros(rows, cols // 32, 3, dtype=torch.int64, device=values.device)
+    for i in range(32):
+        bit = 3 * i
+        word, offset = divmod(bit, 32)
+        words[..., word] |= (v[..., i] << offset) & 0xFFFFFFFF
+        if offset > 29:
+            words[..., word + 1] |= v[..., i] >> (32 - offset)
+    words = torch.where(words >= 2**31, words - 2**32, words)
+    return words.reshape(rows, cols * 3 // 32).to(torch.int32)
+
+
 class ExllamaLinearKernel(MPLinearKernel):
-    SUPPORTED_QUANT_TYPES = [scalar_types.uint4b8, scalar_types.uint8b128]
-    # In theory supports `scalar_types.uint2b2, scalar_types.uint3b4` too but
-    # currently untested so not added to the list
+    SUPPORTED_QUANT_TYPES = [
+        scalar_types.uint2b2,
+        scalar_types.uint3b4,
+        scalar_types.uint4b8,
+        scalar_types.uint8b128,
+    ]
 
     @classmethod
     def get_min_capability(cls) -> int:
@@ -32,11 +59,11 @@ class ExllamaLinearKernel(MPLinearKernel):
                 "Exllama is only supported on CUDA and ROCm",
             )
 
-        if c.partition_weight_shape[1] % (32 // c.weight_type.size_bits) != 0:
+        if c.partition_weight_shape[1] % _zp_pack_columns(c.weight_type) != 0:
             return (
                 False,
-                "Output features must be a multiple of the pack "
-                "factor (32 / num_bits) so that we can correctly "
+                "Output features must be a multiple of "
+                f"{_zp_pack_columns(c.weight_type)} so that we can correctly "
                 "pack the zero points",
             )
 
@@ -98,7 +125,12 @@ class ExllamaLinearKernel(MPLinearKernel):
                     "exllama kernel adding 1 to the zero points during "
