# Copy to .env at the repo root. Values come from the Notion Credentials page.
# Never commit .env.
ATLAS_DATA_DIR=data

# Published calendar feeds (bearer URLs: anyone with the link can read the calendar)
OUTLOOK_ICS_URL=
CAMPUS_EVENTS_ICS_URL=
CANVAS_ICS_URL=

# GroupMe (K4). One bot per group; a bot posts only into the group it was created in.
GROUPME_BOT_CLASS=
GROUPME_BOT_FRIENDS=
# Optional: read the live groups instead of our own posts (dev.groupme.com, top right)
GROUPME_ACCESS_TOKEN=

# Circle shared state (N1). Pooled Neon connection string; install with pip install -e ".[neon]"
# The only database setting the Python app reads. (`neon deploy` keeps its own DATABASE_URL in .env.local for the
# Neon command line; the app does not read that file.) Check and create the tables: python -m contexts.circle.schema --check
NEON_DATABASE_URL=
# How to reach it: auto (default: port 5432, then HTTPS on 443 if 5432 is blocked), tcp, or https. contexts/circle/README.md
# ATLAS_NEON_TRANSPORT=auto
# Join a Circle without editing config/agent.yaml (G6): this box's member id, the circle id every box shares, and
# 1 to opt in to sharing a named place and the daily summaries. contexts/circle/README.md
# ATLAS_CIRCLE_MEMBER=hemdutt
# ATLAS_CIRCLE_ID=team
# ATLAS_CIRCLE_SHARE=1
# Face share (off by default): let named friends' boxes in your Circle recognise you, with your own face template
# sealed to their box after a card on each side. Same as circle.face_share in config/agent.yaml. contexts/circle/README.md
# ATLAS_CIRCLE_FACE_SHARE=1

# Health import from a watch (K9). Read-only connection string to the FreeReps database on the Pi;
# install the driver with pip install -e ".[neon]". Leave empty on a box without it.
FREEREPS_DATABASE_URL=
