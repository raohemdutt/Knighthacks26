{
  "name": "Atlas",
  "short_name": "Atlas",
  "description": "Ask your desk what happened, see what is due, and approve what Atlas wants to do.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef2f8",
  "theme_color": "#eef2f8",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/api/files/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "file", "accept": ["*/*"] }] }
  },
  "shortcuts": [
    { "name": "Approvals", "url": "/approvals/" },
    { "name": "Today", "url": "/today/" },
    { "name": "Files", "url": "/files/" }
  ]
}
